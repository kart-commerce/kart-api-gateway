{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Identity": {
    "JwksUri": "http://identity:8080/.well-known/jwks.json"
  },

  "Observability": {
    "Otlp": {
      "Endpoint": ""
    }
  },

  "_comment_ReverseProxy": "Route table is docs/services/kart-api-gateway/api-contract.yaml's declared identity-auth/identity-jwks/category-read/category-write entries verbatim, plus one defensible-default extension per service (design-decisions.md 'Adding a Future Service's Route' pattern) covering the other 11 real services this release brings up: public-catalog GET routes (category/product/search) are anonymous, everything else requires a validated bearer token. This extension goes beyond kart-api-gateway/tickets.md's approved GW-1 two-service scope (identity + category only) -- flagged here, not silently assumed. notification-service has no HTTP surface (event-driven only, api-contract.yaml paths: {}) so it has no route. The 'admin' route/cluster is the coarse-role-gated addition tickets.md GW-1's note anticipated ('a future service's route needing this is that pass's own addition') -- kart-admin-service/contracts/api-contract.yaml gates every /admin/* endpoint on bearerAuth:[admin], so this route uses the new AdminOnly policy (AuthenticationExtensions.cs) instead of the generic 'authenticated' one every other write route uses.",

  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/v1/auth/{**catch-all}" }
      },
      "identity-jwks": {
        "ClusterId": "identity",
        "Match": { "Path": "/.well-known/jwks.json" }
      },

      "category-read": {
        "ClusterId": "category",
        "Match": { "Path": "/v1/categories/{**catch-all}", "Methods": [ "GET" ] }
      },
      "category-write": {
        "ClusterId": "category",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/categories/{**catch-all}", "Methods": [ "POST", "PATCH", "DELETE" ] }
      },

      "product-read": {
        "ClusterId": "product",
        "Match": { "Path": "/v1/products/{**catch-all}", "Methods": [ "GET" ] }
      },
      "product-write": {
        "ClusterId": "product",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/products/{**catch-all}", "Methods": [ "POST", "PATCH", "DELETE" ] }
      },
      "product-groups-read": {
        "ClusterId": "product",
        "Match": { "Path": "/v1/product-groups/{**catch-all}", "Methods": [ "GET" ] }
      },
      "product-groups-write": {
        "ClusterId": "product",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/product-groups/{**catch-all}", "Methods": [ "POST", "PATCH", "DELETE" ] }
      },

      "search-read": {
        "ClusterId": "search",
        "Match": { "Path": "/v1/search/{**catch-all}", "Methods": [ "GET" ] }
      },

      "user": {
        "ClusterId": "user",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/users/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/inventory/{**catch-all}" }
      },
      "cart": {
        "ClusterId": "cart",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/cart/{**catch-all}" }
      },
      "order": {
        "ClusterId": "order",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/orders/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/payments/{**catch-all}" }
      },
      "offer-coupons": {
        "ClusterId": "offer",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/coupons/{**catch-all}" }
      },
      "offer-pricing": {
        "ClusterId": "offer",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/pricing/{**catch-all}" }
      },
      "offer-promotions": {
        "ClusterId": "offer",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/promotions/{**catch-all}" }
      },
      "wishlist": {
        "ClusterId": "wishlist",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/wishlist/{**catch-all}" }
      },
      "delivery-tracking": {
        "ClusterId": "delivery-tracking",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/v1/tracking/{**catch-all}" }
      },
      "admin": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/v1/admin/{**catch-all}" }
      }
    },

    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity:8080/" } } },
      "category": { "Destinations": { "d1": { "Address": "http://category:8080/" } } },
      "product": { "Destinations": { "d1": { "Address": "http://product:8080/" } } },
      "search": { "Destinations": { "d1": { "Address": "http://search:8080/" } } },
      "user": { "Destinations": { "d1": { "Address": "http://user:8080/" } } },
      "inventory": { "Destinations": { "d1": { "Address": "http://inventory:8080/" } } },
      "cart": { "Destinations": { "d1": { "Address": "http://cart:8080/" } } },
      "order": { "Destinations": { "d1": { "Address": "http://order:8080/" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://payment:8080/" } } },
      "offer": { "Destinations": { "d1": { "Address": "http://offer:8080/" } } },
      "wishlist": { "Destinations": { "d1": { "Address": "http://wishlist:8080/" } } },
      "delivery-tracking": { "Destinations": { "d1": { "Address": "http://delivery-tracking:8080/" } } },
      "admin": { "Destinations": { "d1": { "Address": "http://admin:8080/" } } }
    }
  }
}
