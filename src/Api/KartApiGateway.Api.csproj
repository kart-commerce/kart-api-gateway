<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <!--
    kart-conventions.md Observability section: Kart.Shared.Observability wires Serilog + the
    OpenTelemetry SDK behind one DI call - never reimplemented per service.
  -->
  <ItemGroup>
    <PackageReference Include="Kart.Shared.Observability" Version="0.3.0" />
  </ItemGroup>

</Project>
