# ---- .NET build output ----
bin/
obj/
out/
publish/
artifacts/

# ---- Test results ----
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# ---- NuGet ----
# This repo vendors kart-shared package(s) in packages/ (see nuget.config) -
# keep those tracked, only ignore stray/local nupkgs elsewhere.
*.nupkg
*.snupkg
!packages/*.nupkg
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# ---- Visual Studio / Rider / VS Code ----
.vs/
.idea/
.vscode/
*.user
*.userosscache
*.suo
*.userprefs
*.DotSettings.user

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Env / secrets ----
.env
.env.*
!.env.example
appsettings.*.local.json
